# ==============================================================================
# InsightPilot AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the appropriate values for your environment.
# DO NOT commit real secrets, API keys, credentials, or tokens to version control.

# Application Environment (development | staging | production | test)
APP_ENV=development

# Google Gemini API Key (Required for LLM reasoning & narrative generation)
GEMINI_API_KEY=

# Database Connection URL (e.g. postgresql://user:pass@localhost:5432/insightpilot)
DATABASE_URL=
